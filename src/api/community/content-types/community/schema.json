{
  "kind": "collectionType",
  "collectionName": "communities",
  "info": {
    "singularName": "community",
    "pluralName": "communities",
    "displayName": "Community",
    "description": "Communauté regroupant des compagnons"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "admins": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::community-profile.community-profile",
      "inversedBy": "adminOfCommunities"
    },
    "members": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::community-profile.community-profile",
      "inversedBy": "communities"
    },
    "reunions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::community-group.community-group",
      "mappedBy": "community"
    }
  }
}
